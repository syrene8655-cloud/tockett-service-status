[Unit]
Description=Tockett direct Hong Kong observation and alerts from Shanghai
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 -B /opt/tockett-status-alert/monitor.py
StateDirectory=tockett-status-alert
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/tockett-status-alert /var/www/tockett-status
TimeoutStartSec=75
